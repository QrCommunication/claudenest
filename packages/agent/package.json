{
  "name": "@claudenest/agent",
  "version": "2.12.0",
  "description": "ClaudeNest Agent - Local daemon for remote orchestration of Claude Code instances",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "claudenest-agent": "dist/index.js",
    "claudenest-mcp": "dist/mcp/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/add-shebangs.js",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agent",
    "remote",
    "orchestration",
    "pty",
    "terminal"
  ],
  "author": "Rony Licha / QR Communication",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://claudenest.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QrCommunication/claudenest.git",
    "directory": "packages/agent"
  },
  "bugs": {
    "url": "https://github.com/QrCommunication/claudenest/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "keytar": "^7.9.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0",
    "utf-8-validate": "^6.0.6"
  }
}
