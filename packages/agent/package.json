{
  "name": "@claudenest/agent",
  "version": "2.8.4",
  "description": "ClaudeNest Agent - Local daemon for remote orchestration of Claude Code instances",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "claudenest-agent": "dist/index.js",
    "claudenest-mcp": "dist/mcp/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/add-shebangs.js",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agent",
    "remote",
    "orchestration",
    "pty",
    "terminal"
  ],
  "author": "Rony Licha / QR Communication",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://claudenest.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QrCommunication/claudenest.git",
    "directory": "packages/agent"
  },
  "bugs": {
    "url": "https://github.com/QrCommunication/claudenest/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^15.0.0",
    "keytar": "^7.9.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8",
    "utf-8-validate": "^6.0.4"
  }
}
