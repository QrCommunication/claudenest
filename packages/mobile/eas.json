{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://claudenest.io",
        "EXPO_PUBLIC_REVERB_APP_KEY": "ba5e8c79e195359afbe9bea81384770a",
        "EXPO_PUBLIC_REVERB_HOST": "claudenest.io",
        "EXPO_PUBLIC_REVERB_PORT": "443",
        "EXPO_PUBLIC_REVERB_SCHEME": "https"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://claudenest.io",
        "EXPO_PUBLIC_REVERB_APP_KEY": "ba5e8c79e195359afbe9bea81384770a",
        "EXPO_PUBLIC_REVERB_HOST": "claudenest.io",
        "EXPO_PUBLIC_REVERB_PORT": "443",
        "EXPO_PUBLIC_REVERB_SCHEME": "https"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://claudenest.io",
        "EXPO_PUBLIC_REVERB_APP_KEY": "ba5e8c79e195359afbe9bea81384770a",
        "EXPO_PUBLIC_REVERB_HOST": "claudenest.io",
        "EXPO_PUBLIC_REVERB_PORT": "443",
        "EXPO_PUBLIC_REVERB_SCHEME": "https"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-services-key.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "rony@qrcommunication.app",
        "ascAppId": "REPLACE_WITH_ASC_APP_ID",
        "appleTeamId": "REPLACE_WITH_TEAM_ID"
      }
    }
  }
}
